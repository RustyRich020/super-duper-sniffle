# Microsoft Entra — single-tenant interactive authentication.
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-application-client-secret
AZURE_TENANT_ID=your-qqstudios-directory-tenant-id
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-at-least-32-random-bytes

# Fail-closed allowlist. Sign-in is denied when this value is empty.
WORKSPACE_ALLOWED_EMAILS=richard@QQStudios.onmicrosoft.com

# Supabase data service. These legacy browser settings remain only while the
# forms persistence layer is moved behind authenticated server routes.
NEXT_PUBLIC_SUPABASE_URL=https://meosdrvquwybipqjrzwv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
