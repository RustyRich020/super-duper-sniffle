# Microsoft Entra — single-tenant interactive authentication.
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-application-client-secret
AZURE_TENANT_ID=your-qqstudios-directory-tenant-id
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-at-least-32-random-bytes

# Fail-closed Entra authorization. Configure at least one approved app role or
# security-group object ID. Sign-in is denied when both values are empty.
WORKSPACE_ALLOWED_APP_ROLES=Workspace.Admin,Workspace.Contributor,Workspace.Reader
WORKSPACE_ALLOWED_GROUP_IDS=entra-security-group-object-id
